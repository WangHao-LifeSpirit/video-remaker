MOCK_MODE=true
LLM_PROVIDER=mock

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=
# 分析原视频关键帧用的视觉模型；留空默认 gpt-4o。即使 LLM_PROVIDER=deepseek，
# 只要配置了 OPENAI_API_KEY，分析步骤也会自动用 OpenAI 视觉来"看懂"原片。
OPENAI_VISION_MODEL=

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

VIDEO_PROVIDER=mock

SEEDANCE_API_KEY=
SEEDANCE_API_BASE_URL=https://ark.cn-beijing.volces.com
SEEDANCE_MODEL=doubao-seedance-1-0-pro-250528
SEEDANCE_RESOLUTION=720p
SEEDANCE_WATERMARK=false
SEEDANCE_CAMERA_FIXED=false

KLING_ACCESS_KEY=
KLING_SECRET_KEY=
KLING_API_BASE_URL=https://api.klingai.com
KLING_MODE=omni
KLING_MODEL_NAME=
KLING_ENDPOINT_PATH=/v1/videos/omni-video
KLING_TEXT2VIDEO_ENDPOINT_PATH=/v1/videos/text2video
KLING_IMAGE2VIDEO_ENDPOINT_PATH=/v1/videos/image2video

TTS_PROVIDER=mock
TTS_API_KEY=
TTS_API_BASE_URL=
VOLC_TTS_API_KEY=
VOLC_TTS_APP_ID=
VOLC_TTS_ACCESS_TOKEN=
VOLC_TTS_CLUSTER=
VOLC_TTS_VOICE_TYPE=
VOLC_TTS_API_BASE_URL=https://openspeech.bytedance.com/api/v1/tts
OPENAI_TTS_API_KEY=
OPENAI_TTS_MODEL=
OPENAI_TTS_VOICE=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ENABLE_PAID_TTS_CALLS=false

ASR_PROVIDER=mock
ASR_API_KEY=
ASR_API_BASE_URL=

FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

ENABLE_PAID_API_CALLS=false
MAX_VIDEO_SCENES_PER_RUN=1
MAX_RETRY_PER_SCENE=1
# 分析步骤最多送入多少张关键帧给视觉模型（控制 token 成本），默认 6。
MAX_ANALYSIS_FRAMES=6
